{
  "name": "nextjs-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "oxlint src .storybook e2e next.config.ts postcss.config.mjs vitest.config.ts playwright.config.ts oxfmt.config.ts oxlint.config.ts",
    "lint:fix": "oxlint --fix src .storybook e2e next.config.ts postcss.config.mjs vitest.config.ts playwright.config.ts oxfmt.config.ts oxlint.config.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "setup:repo": "bash scripts/setup-repo.sh",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.2",
    "knip": "6.38.0",
    "lefthook": "2.1.14",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "postcss": "8.5.28",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.5.1"
}
